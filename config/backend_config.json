{
    "analysis": {
        "test_mode": "quick",
        "test_size": 1024
    },
    "crypto": {
        "iterations": 100000,
        "key_size": 256,
        "salt_size": 32
    },
    "entropy": {
        "pool_buffer_size": 8192,
        "pool_refill_threshold": 4096,
        "source": "auto",
        "whitening": "lfsr"
    },
    "http": {
        "port": 8080
    },
    "log": {
        "console_output": true,
        "file": "logs/backend.log",
        "level": "INFO"
    },
    "serial": {
        "baud_rate": 921600,
        "port": "COM3",
        "timeout_ms": 5000
    },
    "server": {
        "frontend_path": "./frontend",
        "max_upload_size": 10485760
    }
}